{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "ignores": [
    "node_modules",
    // Generated by release-please; its formatting is not ours to fix.
    "CHANGELOG.md",
    // Gitignored: agent tool state and planning artifacts, not repo content.
    ".serena",
    "docs",
    // Gitignored Playwright output. A failing test writes error-context.md
    // files here, which would otherwise fail the lint and mask the real failure.
    "test-results",
    "playwright-report"
  ]
}
