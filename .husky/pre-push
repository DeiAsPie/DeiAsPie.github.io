# Heavy verification runs here rather than in CI.
#
# Lighthouse and axe both need a real browser. Running them on GitHub meant
# downloading ~280 MB of Chromium on every push, and the runner images disable
# unprivileged user namespaces, so Chrome aborts with "No usable sandbox!".
# Locally the browser is already on disk and the sandbox works.
#
# This gate blocks the push on failure and has no bypass. CI still runs the
# build, the linters, pytest, the size budgets and the Playwright smoke tests,
# so a push from a machine without this hook is not unguarded.

set -e

PORT=8080

npm run build

npx http-server public -p "$PORT" --silent &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT

for _ in $(seq 1 20); do
  if curl -sSf "http://localhost:$PORT" >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

if ! curl -sSf "http://localhost:$PORT" >/dev/null 2>&1; then
  echo "pre-push: static server did not come up on port $PORT" >&2
  exit 1
fi

BASE="http://localhost:$PORT"
URLS="$BASE/,$BASE/about/,$BASE/recommendations/"

LH_URLS="$URLS" node scripts/run_lighthouse.mjs
AXE_URLS="$URLS" node scripts/run_axe.mjs
