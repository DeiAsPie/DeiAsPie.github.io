# Pre-push runs all non-Playwright CI checks locally before push, so failures
# surface here rather than after a push.
#
# Lighthouse and axe run via scripts/audit.sh, the same script CI calls. They are
# no longer local-only: run_lighthouse.mjs passes --no-sandbox, which is what the
# GitHub runner images need.
#
# The gate blocks the push on failure and has no bypass. CI still runs all checks
# including the Playwright smoke tests (which this hook excludes—too slow for a
# pre-push hook) as a final verification.

set -e

npm run build
node scripts/check_css_size.js
npm run size:images:check
npm run lint:content
npm run lint:markdown
npm run lint
pytest -q

sh scripts/audit.sh
